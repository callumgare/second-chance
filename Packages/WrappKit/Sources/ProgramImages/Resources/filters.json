{
  "comment": "Paths the crawl leaves alone (skip) or reads but ranks down (demote). Patterns are matched, lower-cased, against a file's path inside the container it was found in: ** is any number of folders, * anything within a name, ? one character. A pattern without a / is matched against the name alone. keep wins over the rest. docs/program-images.md#the-filter-table",
  "keep": [
    "autorun.inf",
    "*.lnk"
  ],
  "skip": [
    { "pattern": "*.txt", "reason": "text" },
    { "pattern": "*.rtf", "reason": "text" },
    { "pattern": "*.doc", "reason": "text" },
    { "pattern": "*.htm", "reason": "text" },
    { "pattern": "*.html", "reason": "text" },
    { "pattern": "*.ini", "reason": "settings" },
    { "pattern": "*.inf", "reason": "setup information" },
    { "pattern": "*.cue", "reason": "text" },
    { "pattern": "*.nfo", "reason": "text" },
    { "pattern": "*.log", "reason": "text" },
    { "pattern": "*.xml", "reason": "text" },
    { "pattern": "*.reg", "reason": "text" },
    { "pattern": "*.wav", "reason": "sound" },
    { "pattern": "*.mid", "reason": "music" },
    { "pattern": "*.midi", "reason": "music" },
    { "pattern": "*.mp3", "reason": "sound" },
    { "pattern": "*.ogg", "reason": "sound" },
    { "pattern": "*.voc", "reason": "sound" },
    { "pattern": "*.aif", "reason": "sound" },
    { "pattern": "*.aiff", "reason": "sound" },
    { "pattern": "*.his", "reason": "sound (Her Interactive)" },
    { "pattern": "*.ttf", "reason": "font" },
    { "pattern": "*.otf", "reason": "font" },
    { "pattern": "*.fon", "reason": "font" },
    { "pattern": "*.fnt", "reason": "font" },
    { "pattern": "thumbs.db", "reason": "Explorer's cache" },
    { "pattern": ".ds_store", "reason": "Finder's settings" },
    { "pattern": "desktop db", "reason": "the classic Finder's desktop database" },
    { "pattern": "desktop df", "reason": "the classic Finder's desktop database" },
    { "pattern": "appleshare pds", "reason": "AppleShare's settings" },
    { "pattern": "openfolderlistdf", "reason": "the classic Finder's settings" },
    { "pattern": "_isdel.exe", "reason": "InstallShield's own" },
    { "pattern": "_inst32i.ex_", "reason": "InstallShield's own" },
    { "pattern": "_setup.dll", "reason": "InstallShield's own" },
    { "pattern": "unins*.dat", "reason": "Inno Setup's uninstall log" },
    { "pattern": "**/drive_c/windows/**", "reason": "Wine's own Windows" },
    { "pattern": "**/drive_c/program files*/internet explorer/**", "reason": "Wine's own" },
    { "pattern": "**/drive_c/program files*/windows media player/**", "reason": "Wine's own" },
    { "pattern": "**/drive_c/program files*/windows nt/**", "reason": "Wine's own" },
    { "pattern": "**/drive_c/program files*/common files/**", "reason": "shared components" },
    { "pattern": "**/drive_c/users/*/appdata/local/temp/**", "reason": "temporary files" },
    { "pattern": "**/drive_c/users/*/temp/**", "reason": "temporary files" },
    { "pattern": "**/dosdevices/**", "reason": "Wine's drive links" },
    { "pattern": "contents/resources/engines/**", "reason": "the wrapp's engines" },
    { "pattern": "contents/frameworks/**", "reason": "the wrapp's frameworks" },
    { "pattern": "contents/macos/**", "reason": "the wrapp's launcher" },
    { "pattern": "contents/_codesignature/**", "reason": "code signature" },
    { "pattern": "contents/sharedsupport/wine/**", "reason": "the wrapp's engine" },
    { "pattern": "contents/sharedsupport/engines/**", "reason": "the wrapp's engines" },
    { "pattern": "**/genericwrappicon.icns", "reason": "Second Chance's own icon" },
    { "pattern": "**/wrapptemplateicon.icns", "reason": "Second Chance's own icon" },
    { "pattern": "**/directx/**", "reason": "DirectX's installer" },
    { "pattern": "dxsetup.exe", "reason": "DirectX's installer" },
    { "pattern": "dsetup*.dll", "reason": "DirectX's installer" }
  ],
  "demote": [
    { "pattern": "msvcr*.dll", "reason": "runtime library" },
    { "pattern": "msvcp*.dll", "reason": "runtime library" },
    { "pattern": "msvcrt*.dll", "reason": "runtime library" },
    { "pattern": "mfc*.dll", "reason": "runtime library" },
    { "pattern": "msvbvm*.dll", "reason": "runtime library" },
    { "pattern": "vb40032.dll", "reason": "runtime library" },
    { "pattern": "d3dx*.dll", "reason": "runtime library" },
    { "pattern": "comctl32.dll", "reason": "runtime library" },
    { "pattern": "comdlg32.dll", "reason": "runtime library" },
    { "pattern": "binkw32.dll", "reason": "runtime library" },
    { "pattern": "smackw32.dll", "reason": "runtime library" },
    { "pattern": "mss32.dll", "reason": "runtime library" },
    { "pattern": "qtmlclient.dll", "reason": "runtime library" },
    { "pattern": "**/system/**", "reason": "system folder" },
    { "pattern": "**/system32/**", "reason": "system folder" },
    { "pattern": "**/redist/**", "reason": "redistributable" },
    { "pattern": "**/quicktime/**", "reason": "QuickTime's installer" },
    { "pattern": "**/system folder/**", "reason": "classic Mac system folder" },
    { "pattern": "**/extensions/**", "reason": "classic Mac extensions" },
    { "pattern": "**/control panels/**", "reason": "classic Mac control panels" }
  ]
}
