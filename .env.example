# Copy to .env (which git ignores) and fill in to build a Second Chance that
# sends failure reports, and to let `sc release` upload debug symbols.
# docs/failure-reports.md has what each is.

# The Sentry project's DSN. Built into the app's Info.plist; empty or missing
# means the build sends no reports.
SENTRY_DSN=

# The Sentry organisation's and project's slugs, for `sc release`'s
# debug-symbol upload with sentry-cli.
SENTRY_ORG=
SENTRY_PROJECT=second-chance

# The auth token stays in the login keychain, not here (docs/releasing.md).
