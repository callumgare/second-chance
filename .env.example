# Copy to .env (which git ignores, and `sc --on` doesn't sync) and fill in to
# build a Second Chance that sends failure reports, to let `sc release` upload
# debug symbols, and to choose whether tests hide their windows on this Mac.
# docs/failure-reports.md has what the Sentry settings are.

# The Sentry project's DSN. Built into the app's Info.plist; empty or missing
# means the build sends no reports.
SENTRY_DSN=

# The Sentry organisation's and project's slugs, for `sc release`'s
# debug-symbol upload with sentry-cli.
SENTRY_ORG=
SENTRY_PROJECT=second-chance

# The auth token stays in the login keychain, not here (docs/releasing.md).

# 1: the app hosting `sc test unit` and `sc test integration` keeps its
# windows and Dock icon out of the way, for a Mac someone is using while the
# tests run. Leave it out on a test Mac, where seeing them helps explain a
# failure (docs/testing.md).
SECOND_CHANCE_HIDE_TEST_UI=
