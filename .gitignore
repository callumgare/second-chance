.DS_Store
.local

*.profraw
*.xcuserstate
xcuserdata/

/DerivedData
/build

# Claude Code's own files stay out; the porting skill and its agents are the repo's.
.claude/*
!.claude/skills/
!.claude/agents/

/installers
/built-apps

/test-output
/test-results

*.build-cache
# sc (Tools/sc) build output
/Tools/sc/.build
/Tools/sc/.swiftpm
/Tools/sc/.run
# Icon Lab's dev server (Tools/icon-lab/server) build output, and its page's packages
/Tools/icon-lab/server/.build
/Tools/icon-lab/server/.swiftpm
/Tools/icon-lab/web/node_modules

# Local settings: the Sentry DSN and slugs (.env.example)
/.env

# What `swift build` or `swift test` leave in a package under Packages/. Xcode
# resolves the package's dependencies in the project's own Package.resolved.
/Packages/*/.build
/Packages/Modules/*/.build
/Packages/*/.swiftpm
/Packages/Modules/*/.swiftpm
/Packages/*/Package.resolved
/Packages/Modules/*/Package.resolved

# SourceKit-LSP's settings, which sc worktree prepare writes into a worktree's
# packages to turn off background indexing (docs/dev-cli.md#worktrees)
.sourcekit-lsp/
