{
    "cSpell.words": [
        "wrapp"
    ],
    // No npm here, and its package.json scan follows symlinks without
    // honouring .gitignore, so it crawls the whole disk through Wine
    // prefixes' dosdevices/z: -> /
    "npm.autoDetect": "off",
    // Same reason, for every extension's file search (Copilot's test
    // set-up looks for package.json the same way)
    "search.followSymlinks": false,
    // Build and test output; the file watcher ignores .gitignore
    "files.watcherExclude": {
        "**/build/**": true,
        "**/built-apps/**": true,
        "**/installers/**": true,
        "**/test-output/**": true,
        "**/test-results/**": true
    }
}