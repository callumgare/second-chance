# Lure of the Temptress: its data, as the zip has it, in the app's own
# folder, for ScummVM to read.

INPUT game
STORE scummvm-saves
STORE scummvm-settings

FROM scratch AS download
USE scummvm
SCUMMVM.KEEP-DATA lure.dat
COPY --from=${input.game} lure /SharedSupport/game/ # the zip's lure/ folder: the game's data and its licence
LAUNCH --mount=type=store,source=scummvm-saves,target=scummvm:saves/
LAUNCH --mount=type=store,source=scummvm-settings,target=scummvm:settings/
LAUNCH scummvm:/SharedSupport/game/ lure
# Its icon, made in Icon Lab (assets/lure-of-the-temptress.icon, compiled by `sc generate`).
COPY bundle:assets/lure-of-the-temptress.icns /Resources/lure-of-the-temptress.icns
APP --icon=/Resources/lure-of-the-temptress.icns
