# Icy Tower: its makers' Inno Setup installer, run silently into a folder of
# our choosing, then removed. An Allegro 4 game that draws with DirectDraw
# and reads only the keyboard. It keeps its settings and high scores in
# tower.cfg beside itself, written as it exits, and replays in replays/, so
# files mounts keep just those beside the program.

INPUT game
STORE saves
STORE replays
CONST install-dir = "C:/IcyTower"

FROM --module=wine@10 prefix AS download
DO wine.cnc-ddraw
# Allegro's windowed driver (its Fullscreen: No, and its first try at every
# start) checks that its window's client area is the 640x480 it asked for.
# Asked for a window, cnc-ddraw makes up a display mode the size the window
# was then (a sliver) and reports that as the client area, so Allegro gave
# up, and switching to it from the options crashed the game. A made-up mode
# of 640x480 makes the check pass, for this game only (its exe's section).
EDIT C:/windows/syswow64/ddraw.ini --ini=icytower13.fake_mode=640x480x16
# Allegro's timer can hang its exit, waiting on a thread's handle Wine has
# closed and given out again.
DO wine.keep-thread-handles
COPY --from=${input.game} . C:/icy-tower-setup/ # the installer, as it comes
RUN "C:/icy-tower-setup/icytower13_install.exe" /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- /NOICONS /DIR=C:\IcyTower
REMOVE C:/icy-tower-setup
# It ignores Wine's quit and its window's close button, and quits through its
# own menus. The app's first Quit presses Escape once, which asks the player
# in the game; a second Quit soon after holds Escape down, and its repeats
# take it through every screen to Exit in a second or two, as a player
# holding Escape would (from a game, two leave for the menu and two more
# choose Exit; a game paused with P takes one more). Not past the high-score
# name box, which waits for the player.
LAUNCH --mount=type=store,source=saves,target=${const.install-dir}/,files="tower.cfg" \
    --mount=type=store,source=replays,target=${const.install-dir}/replays/,files="*.itr" \
    --wine.graphics=direct-draw --wine.cursor-lock --wine.quit-key=escape \
    --wine.quit-confirm-key=escape \
    "${const.install-dir}/icytower13.exe"
