# Icy Tower: its makers' Inno Setup installer, run silently into a folder of
# our choosing, then removed. An Allegro 4 game that draws with DirectDraw
# and reads only the keyboard. It keeps its settings and high scores in
# tower.cfg beside itself, written as it exits, and replays in replays/, so
# files mounts keep just those beside the program.

INPUT game
STORE saves
STORE replays
CONST install-dir = "C:/IcyTower"

# Wine 10: its keep-thread-handles patch knows only Wine 10's msvcrt.dll
# (11.21's _endthread uses CloseHandle's result, so the patch refuses it),
# and Icy Tower needs the patch to exit cleanly.
FROM --module=wine@10 prefix AS download
DO wine.cnc-ddraw
# Allegro's windowed driver (its Fullscreen: No, and its first try at every
# start) checks that its window's client area is the 640x480 it asked for.
# Asked for a window, cnc-ddraw makes up a display mode the size the window
# was then (a sliver) and reports that as the client area, so Allegro gave
# up, and switching to it from the options crashed the game. A made-up mode
# of 640x480 makes the check pass, for this game only (its exe's section).
EDIT C:/windows/syswow64/ddraw.ini --ini=icytower13.fake_mode=640x480x16
# Patch: a thread msvcrt's _beginthread started keeps its handle when it
# ends. Why: Allegro's timer waits, with no limit, on its thread's handle as
# the game exits; the C runtime has closed it by then, and once Wine has given
# the value to something else the wait never ends (about 3 exits in 11 on
# macOS 26). To go: Allegro waiting on a handle of its own (it can't be
# changed in this game), or a Wine that doesn't reuse a closed handle's value
# that soon; none does yet.
WINE.PATCH keep-thread-handles
COPY --from=${input.game} . C:/icy-tower-setup/ # the installer, as it comes
RUN "C:/icy-tower-setup/icytower13_install.exe" /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- /NOICONS /DIR=C:\IcyTower
REMOVE C:/icy-tower-setup
# It's played with the keyboard, so cnc-ddraw never takes the mouse
# (--wine.mouse=free): in a window, its lock drew the cursor pinned at the
# window's edge while the Mac's pointer left it and clicked whatever was
# outside.
# It ignores Wine's quit and its window's close button, and quits through its
# own menus. The app's first Quit presses Escape once, which asks the player
# in the game; a second Quit soon after holds Escape down, and its repeats
# take it through every screen to Exit in a second or two, as a player
# holding Escape would (from a game, two leave for the menu and two more
# choose Exit; a game paused with P takes one more). Not past the high-score
# name box, which waits for the player.
# Its Options > GFX > Fullscreen is the int32 at 16 in tower.cfg, an Allegro
# packfile: -1 for Yes, 0 for No. The int32 at 96 is 17 times the sum of the
# eight settings there and 28, which it checks as it loads (a file that fails
# gets the defaults). When the player last switched with the window's green
# button rather than the game's menu, the app writes their choice there once
# the game has quit, so the next start opens as they left it.
LAUNCH --mount=type=store,source=saves,target=${const.install-dir}/,files="tower.cfg" \
    --mount=type=store,source=replays,target=${const.install-dir}/replays/,files="*.itr" \
    --wine.graphics=direct-draw --wine.mouse=free --wine.quit-key=escape \
    --wine.quit-confirm-key=escape:hold=5s \
    --wine.fullscreen-setting="file=${const.install-dir}/tower.cfg,format=allegro-packfile,offset=16,bytes=4,fullscreen=-1,windowed=0,checksum-offset=96,checksum-scale=17" \
    "${const.install-dir}/icytower13.exe"
# Its icon, made in Icon Lab (assets/icy-tower.icon, compiled by `sc generate`).
COPY bundle:assets/icy-tower.icns /Resources/icy-tower.icns
APP --icon=/Resources/icy-tower.icns
