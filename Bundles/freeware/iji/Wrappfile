# Iji: the author's zip, copied in as it comes, nothing to install. A Game
# Maker 7 game: it draws with Direct3D 8 (it imports ddraw.dll too, only to
# ask about display modes), and keeps its settings and saves loose in its own
# folder, so a files mount keeps just those beside the program. It ignores
# Wine's quit and its window closing, but quits on F12 held down, so the
# app's Quit holds F12.

INPUT game
STORE saves
CONST install-dir = "C:/Iji"

FROM --module=wine@10 prefix AS download
COPY --from=${input.game} . ${const.install-dir}/ # the zip's files: the game, its music, its manual and its source
# Patch: Wine's DirectMusic synthesiser stops at once instead of first
# playing out its two-second buffer. Why: Game Maker 7 gives each of its
# sounds a DirectMusic performance and stops it again as it loads, so Iji sat
# on "Loading, please wait" for over 6 minutes; with it, about 15 s.
# Winetricks' directmusic loads as fast, but its Microsoft dsound.dll leaves
# the music (MP3s through MCI and DirectShow) silent. To go: Wine 11.2 fixed
# the synthesiser, but every Wine 11 tried crashes Iji at start (11.6 to
# 11.21, a stack overflow in its exception handlers) or loads it for minutes
# (11.0). Once a newer Wine runs Iji, move it there and drop this.
DO wine.skip-synth-playout
LAUNCH --mount=type=store,source=saves,target=${const.install-dir}/,files="*.ini;*.sav;*.cfg" \
    --wine.graphics=direct-3d --wine.window=windowed --wine.quit-key=f12:hold=5s "${const.install-dir}/iji.exe"
