# Tyrian 2000: its DOS files, as the zip has them, for DOSBox to run. DOSBox's
# C: is the C: the game sees, so the folder has a DOS name.

INPUT game
STORE dosbox-saves

FROM scratch AS download
USE dosbox
COPY --from=${input.game} tyrian2000 C:/TYRIAN/ # the zip's tyrian2000/ folder: the whole game
# What the game writes, laid over its C:
LAUNCH --mount=type=store,source=dosbox-saves,target=C:/,dosbox.overlay
LAUNCH C:/TYRIAN/TYRIAN2K.EXE
