# Where Her's download installs the game, whose data ScummVM reads.
CONST install-dir = "C:/Program Files (x86)/Her Interactive/Secrets Can Kill"
INPUT disc-1
INPUT disc-2
INPUT installer

FROM scratch AS prefix
USE wine@10

# The CD edition: ScummVM reads the disc's data, kept in the wrapp and
# patched through Wine, which the wrapp then leaves out.
FROM prefix AS disc
USE nancy-drew
USE scummvm
WINE.KEEP-DISCS ${input.disc-1} ${input.disc-2} --into=C:/nancy-drew-installer --combined=C:/nancy-drew-installer/disk-combined
EXPORT C:/nancy-drew-installer/disk-combined

# Her Interactive's download: a Windows installer, or a Mac app whose
# Windows game is taken out
FROM prefix AS her-download
USE her-download
USE nancy-drew
USE scummvm
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir}

