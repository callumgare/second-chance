# ScummVM reads the game's data from the app's own folder; Wine is only
# what some editions need to get the data out, and isn't kept.
INPUT disc-1
INPUT installer
INPUT game
CONST install-dir = "C:/Program Files (x86)/Her Interactive/Treasure in the Royal Tower"
STORE scummvm-saves
STORE scummvm-settings

FROM --module=wine@10 prefix AS prefix

# How the game runs, whichever edition it came from
FROM scratch AS scummvm
USE scummvm
SCUMMVM.KEEP-DATA nancy.dat
COPY module:nancy-drew:/assets/nancy-drew.icns /Resources/nancy-drew.icns
APP --icon=/Resources/nancy-drew.icns
LAUNCH --mount=type=store,source=scummvm-saves,target=scummvm:saves/
LAUNCH --mount=type=store,source=scummvm-settings,target=scummvm:settings/
LAUNCH scummvm:/SharedSupport/game/ nancy:nancy4

# The CD edition: the disc's data, copied as it is
FROM scummvm AS disc
COPY --from=${input.disc-1} . /SharedSupport/game/

# Her Interactive's download: a Windows installer, run under Wine for the
# data it installs
FROM prefix AS her-download-files
USE her-download
USE nancy-drew
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir}

FROM scummvm AS her-download
COPY --from=her-download-files ${const.install-dir} /SharedSupport/game/

# Steam's: the game installed by Steam, for its data
FROM --module=steam@1 client AS steam-files
DO steam.install --game=${input.game} --into=${const.install-dir}

FROM scummvm AS steam
COPY --from=steam-files ${const.install-dir} /SharedSupport/game/

# Big Fish's: the game installed by its Game Manager, for its data
FROM --module=big-fish@1 manager AS big-fish-files
DO big-fish.install --game=${input.game} --into=${const.install-dir}

FROM scummvm AS big-fish
COPY --from=big-fish-files ${const.install-dir} /SharedSupport/game/
