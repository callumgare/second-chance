CONST install-dir = "C:/Program Files (x86)/Nancy Drew/Warnings at Waverly Academy"
INPUT disc-1
INPUT disc-2
INPUT installer
INPUT game

FROM wine@10/prefix AS prefix
COPY module:nancy-drew/assets/nancy-drew.icns /Resources/nancy-drew.icns
ICON /Resources/nancy-drew.icns
VOLUME --wine.drive=A: wine-documents C:/users/crossover/Documents
LAUNCH --wine.graphics=direct-3d "${const.install-dir}/Waverly.exe"

# The CD edition: the disc kept in the wrapp, as the game checks for it
FROM prefix AS disc
USE installer
USE nancy-drew
WINE.KEEP-DISCS ${input.disc-1} ${input.disc-2} --into=C:/nancy-drew-installer --combined=C:/nancy-drew-installer/disk-combined
INSTALLER.RUN --from=${input.disc-1} --into=${const.install-dir} --creates="${const.install-dir}/Waverly.exe"
DO nancy-drew.configure-ini --into=${const.install-dir}

# Her Interactive's download: a Windows installer, or a Mac app whose
# Windows game is taken out
FROM prefix AS her-download
USE her-download
USE nancy-drew
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir} --creates="${const.install-dir}/Waverly.exe"
DO nancy-drew.configure-ini --into=${const.install-dir}

# Steam's: the game installed by Steam, which starts it
FROM steam@1/client AS steam
USE nancy-drew
COPY module:nancy-drew/assets/nancy-drew.icns /Resources/nancy-drew.icns
ICON /Resources/nancy-drew.icns
VOLUME --wine.drive=A: wine-documents C:/users/crossover/Documents
DO steam.install --game=${input.game} --into=${const.install-dir}
DO nancy-drew.configure-ini --into=${const.install-dir}
LAUNCH --wine.graphics=direct-3d \
    --steam.exe="${const.install-dir}/Waverly.exe" steam://rungameid/${input.game.app-id}

# Big Fish's: the game installed by its Game Manager, whose DRM starts it
FROM big-fish@1/manager AS big-fish
USE nancy-drew
COPY module:nancy-drew/assets/nancy-drew.icns /Resources/nancy-drew.icns
ICON /Resources/nancy-drew.icns
VOLUME --wine.drive=A: wine-documents C:/users/crossover/Documents
DO big-fish.install --game=${input.game} --into=${const.install-dir}
DO nancy-drew.configure-ini --into=${const.install-dir}
LAUNCH --wine.graphics=direct-3d \
    --big-fish.exe="${const.install-dir}/Waverly.exe" "big-fish:${const.install-dir}/LaunchGame.bfg"
