INPUT disc-1
INPUT installer
INPUT game
CONST install-dir = "C:/Program Files (x86)/Her Interactive/Labyrinth of Lies"
CONST program = "${const.install-dir}/Labyrinth.exe"
STORE wine-documents

# What the app has whichever edition it's built from
FUNCTION pre-install-setup
  USE nancy-drew
  DO nancy-drew.set-icon
  LAUNCH --mount=type=store,source=wine-documents,target=A: --mount=type=store,source=wine-documents,target=C:/users/crossover/Documents
END

# What every install of the game ends with: its .ini settings
FUNCTION post-install-setup
  DO nancy-drew.configure-ini --into=${const.install-dir}
END

# Wine 10: the Nancy Drew games stay on the Wine they were made and tested
# with. On Wine 11.21 (tried 2026-11-08) two of their installers failed
# (Alibi in Ashes', and Blackmoor Manor's InstallShield, which never
# finished) and a launch took four times as long, so none moves until a
# newer Wine is tried with all of them.
FROM --module=wine@10 prefix AS prefix
DO pre-install-setup
# Her's later engine exits non-zero; its Debug.LOG says whether it quit cleanly
LAUNCH --wine.graphics=direct-3d \
    --wine.clean-exit-log="${nancy-drew.data.clean-exit-log.file}" \
    --wine.clean-exit-line="${nancy-drew.data.clean-exit-log.marker}" \
    ${const.program}

# The CD edition: the disc kept in the wrapp, as the game checks for it
FROM prefix AS disc
USE installer
WINE.KEEP-DISCS ${input.disc-1} --into=C:/nancy-drew-installer
INSTALLER.RUN --from=${input.disc-1} --into=${const.install-dir} --creates=${const.program}
DO post-install-setup

# Her Interactive's download: a Windows installer, or a Mac app whose
# Windows game is taken out
FROM prefix AS her-download
USE her-download
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir} --creates=${const.program}
DO post-install-setup

# Her Interactive's Mac download: a Cider app, whose Windows game is taken
# out where Cider had it. Her's patches update older builds than it, so none
# apply.
FROM prefix AS her-mac
USE her-download
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir}
DO post-install-setup

# Steam's: the game installed by Steam, which starts it
FROM --module=steam@1 client AS steam
DO pre-install-setup
DO steam.install --game=${input.game} --into=${const.install-dir}
DO post-install-setup
# Her's later engine exits non-zero; its Debug.LOG says whether it quit cleanly
LAUNCH --wine.graphics=direct-3d \
    --wine.clean-exit-log="${nancy-drew.data.clean-exit-log.file}" \
    --wine.clean-exit-line="${nancy-drew.data.clean-exit-log.marker}" \
    --steam.exe=${const.program} steam://rungameid/${input.game.app-id}

# Big Fish's: the game installed by its Game Manager, whose DRM starts it
FROM --module=big-fish@1 manager AS big-fish
DO pre-install-setup
DO big-fish.install --game=${input.game} --into=${const.install-dir}
DO post-install-setup
# Her's later engine exits non-zero; its Debug.LOG says whether it quit cleanly
LAUNCH --wine.graphics=direct-3d \
    --wine.clean-exit-log="${nancy-drew.data.clean-exit-log.file}" \
    --wine.clean-exit-line="${nancy-drew.data.clean-exit-log.marker}" \
    --big-fish.exe=${const.program} "big-fish:${const.install-dir}/LaunchGame.bfg"
