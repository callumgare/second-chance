CONST install-dir = "C:/Program Files (x86)/Nancy Drew/Legend of the Crystal Skull"
INPUT disc-1
INPUT disc-2
INPUT installer

FROM scratch AS prefix
USE wine@10

# The CD edition: the disc kept in the wrapp, as the game checks for it
FROM prefix AS disc
USE installer
USE nancy-drew
WINE.KEEP-DISCS ${input.disc-1} ${input.disc-2} --into=C:/nancy-drew-installer --combined=C:/nancy-drew-installer/disk-combined
INSTALLER.RUN --from=${input.disc-1} --into=${const.install-dir} --answer-file=assets/disc.iss
DO nancy-drew.patch --id=crystal-skull-mushroom --into=${const.install-dir}
DO nancy-drew.configure-ini --into=${const.install-dir}

# Her Interactive's download: a Windows installer, or a Mac app whose
# Windows game is taken out
FROM prefix AS her-download
USE her-download
USE nancy-drew
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir}
DO nancy-drew.patch --id=crystal-skull-mushroom --into=${const.install-dir}
DO nancy-drew.configure-ini --into=${const.install-dir}

