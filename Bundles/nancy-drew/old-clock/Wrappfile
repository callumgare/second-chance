CONST install-dir = "C:/Nancy Drew/Secret of the Old Clock"
INPUT disc-1
INPUT installer

FROM scratch AS prefix
USE wine@10

# The CD edition: the disc kept in the wrapp, as the game checks for it
FROM prefix AS disc
USE installer
USE nancy-drew
WINE.KEEP-DISCS ${input.disc-1} --into=C:/nancy-drew-installer
INSTALLER.RUN --from=${input.disc-1} --into=${const.install-dir} --creates="${const.install-dir}/Game.exe" --answer-file=assets/disc.iss \
    --automation=module:nancy-drew/assets/installshield-custom-dialog-automate.au3
DO nancy-drew.configure-ini --into=${const.install-dir}

# Her Interactive's download: a Windows installer, or a Mac app whose
# Windows game is taken out
FROM prefix AS her-download
USE her-download
USE nancy-drew
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir} --creates="${const.install-dir}/Game.exe"
DO nancy-drew.configure-ini --into=${const.install-dir}

