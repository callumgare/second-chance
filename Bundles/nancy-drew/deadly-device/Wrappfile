CONST install-dir = "C:/Program Files (x86)/Her Interactive/The Deadly Device"
INPUT disc-1
INPUT installer
INPUT game

FROM wine@10/prefix AS prefix
COPY module:nancy-drew/assets/nancy-drew.icns /Resources/nancy-drew.icns
ICON /Resources/nancy-drew.icns
VOLUME --wine.drive=A: wine-documents C:/users/crossover/Documents
LAUNCH --wine.graphics=direct-3d "${const.install-dir}/DeadlyDevice.exe"

# The CD edition: the disc kept in the wrapp, as the game checks for it
FROM prefix AS disc
USE installer
USE nancy-drew
WINE.KEEP-DISCS ${input.disc-1} --into=C:/nancy-drew-installer
INSTALLER.RUN --from=${input.disc-1} --into=${const.install-dir} --creates="${const.install-dir}/DeadlyDevice.exe" --answer-file=assets/disc.iss
DO nancy-drew.configure-ini --into=${const.install-dir}

# Her Interactive's download: a Windows installer, or a Mac app whose
# Windows game is taken out
FROM prefix AS her-download
USE her-download
USE nancy-drew
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir} --creates="${const.install-dir}/DeadlyDevice.exe"
DO nancy-drew.configure-ini --into=${const.install-dir}

# Her Interactive's Mac download: a Cider app, whose Windows game is taken
# out where Cider had it. Her's patches update older builds than it, so none
# apply.
FROM prefix AS her-mac
USE her-download
USE nancy-drew
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir}
DO nancy-drew.configure-ini --into=${const.install-dir}

# Steam's: the game installed by Steam, which starts it
FROM steam@1/client AS steam
USE nancy-drew
COPY module:nancy-drew/assets/nancy-drew.icns /Resources/nancy-drew.icns
ICON /Resources/nancy-drew.icns
VOLUME --wine.drive=A: wine-documents C:/users/crossover/Documents
DO steam.install --game=${input.game} --into=${const.install-dir}
DO nancy-drew.configure-ini --into=${const.install-dir}
LAUNCH --wine.graphics=direct-3d \
    --steam.exe="${const.install-dir}/DeadlyDevice.exe" steam://rungameid/${input.game.app-id}
