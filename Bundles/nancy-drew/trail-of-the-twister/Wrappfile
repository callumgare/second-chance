CONST install-dir = "C:/Program Files (x86)/Nancy Drew/Trail of the Twister"
INPUT disc-1
INPUT disc-2
INPUT installer

FROM scratch AS prefix
USE wine@10
COPY module:nancy-drew/assets/nancy-drew.icns /Resources/nancy-drew.icns
ICON /Resources/nancy-drew.icns
VOLUME --wine.drive=A: wine-documents C:/users/crossover/Documents
LAUNCH --wine.graphics=direct-3d "${const.install-dir}/Twister.exe"

# The CD edition: the disc kept in the wrapp, as the game checks for it
FROM prefix AS disc
USE installer
USE nancy-drew
WINE.KEEP-DISCS ${input.disc-1} ${input.disc-2} --into=C:/nancy-drew-installer --combined=C:/nancy-drew-installer/disk-combined
INSTALLER.RUN --from=${input.disc-1} --into=${const.install-dir} --creates="${const.install-dir}/Twister.exe"
DO nancy-drew.patch --id=trail-of-the-twister-doppler-radar --into=${const.install-dir}
DO nancy-drew.configure-ini --into=${const.install-dir}

# Her Interactive's download: a Windows installer, or a Mac app whose
# Windows game is taken out
FROM prefix AS her-download
USE her-download
USE nancy-drew
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir} --creates="${const.install-dir}/Twister.exe"
DO nancy-drew.patch --id=trail-of-the-twister-doppler-radar --into=${const.install-dir}
DO nancy-drew.configure-ini --into=${const.install-dir}

# Her Interactive's Mac download: a Cider app, whose Windows game is taken
# out where Cider had it. Her's patches update older builds than it, so none
# apply.
FROM prefix AS her-mac
USE her-download
USE nancy-drew
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir}
DO nancy-drew.configure-ini --into=${const.install-dir}

