INPUT disc-1
INPUT installer
INPUT game
INPUT launch-mode
CONST install-dir = "C:/Nancy Drew/Secret of Shadow Ranch"
CONST program = "${const.install-dir}/Game.exe"

# What the app has whichever edition it's built from
FUNCTION pre-install-setup
  USE nancy-drew
  DO wine.cnc-ddraw
  DO nancy-drew.set-icon
  VOLUME --wine.drive=A: wine-documents C:/users/crossover/Documents
END

# Her's patches, for the editions they update
FUNCTION patch
  DO nancy-drew.patch --id=shadow-ranch-full --into=${const.install-dir}
END

# What every install of the game ends with: its .ini settings
FUNCTION post-install-setup
  DO nancy-drew.configure-ini --into=${const.install-dir}
END

FROM wine@10/prefix AS prefix
DO pre-install-setup
LAUNCH --wine.graphics=direct-draw ${const.program}

# The CD edition: the disc kept in the wrapp, as the game checks for it
FROM prefix AS disc
USE installer
WINE.KEEP-DISCS ${input.disc-1} --into=C:/nancy-drew-installer
INSTALLER.RUN --from=${input.disc-1} --into=${const.install-dir} --creates=${const.program} --answer-file=assets/disc.iss \
    --automation=module:nancy-drew/assets/installshield-custom-dialog-automate.au3
DO patch
DO post-install-setup

# Her Interactive's download: a Windows installer, or a Mac app whose
# Windows game is taken out
FROM prefix AS her-download
USE her-download
HER-DOWNLOAD.INSTALL ${input.installer} --into=${const.install-dir} --creates=${const.program}
DO patch
DO post-install-setup

# Steam's: the game installed by Steam, and started by it unless the person chose otherwise
FROM steam@1/client AS steam
DO pre-install-setup
DO steam.install --game=${input.game} --into=${const.install-dir}
DO post-install-setup
IF ${input.launch-mode} = "direct"
  # Steam taken away, and the game started by Wine
  STEAM.REMOVE
  LAUNCH --wine.graphics=direct-draw ${const.program}
ELSE
  # Started by Steam, or by Wine when that fails
  LAUNCH --wine.graphics=direct-draw \
      --steam.exe=${const.program} \
      --fallback=${const.program} steam://rungameid/${input.game.app-id}
END

# Big Fish's: the game installed by its Game Manager, whose DRM starts it
FROM big-fish@1/manager AS big-fish
DO pre-install-setup
DO big-fish.install --game=${input.game} --into=${const.install-dir}
DO post-install-setup
LAUNCH --wine.graphics=direct-draw \
    --big-fish.exe=${const.program} "big-fish:${const.install-dir}/LaunchGame.bfg"
