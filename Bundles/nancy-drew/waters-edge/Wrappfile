# Shadow at the Water's Edge: how Second Chance builds it. Written from what its builders did
# for it when bundles came in; change it as the game needs.

ARG install-dir="C:/Program Files (x86)/Nancy Drew/Shadow at the Water's Edge"

FROM scratch AS prefix
USE wine@10                                # set up as the wine module's prefix.yaml says

# The CD edition: the disc kept in the wrapp, as the game checks for it
FROM prefix AS disc
ARG install-dir
USE installer
USE nancy-drew
wine.KEEP-DISCS --into=C:/nancy-drew-installer --combined=C:/nancy-drew-installer/disk-combined
installer.RUN --from=disc-1 --into=${install-dir}
DO nancy-drew.patch --id=waters-edge-recorder-tea-ceremony --into=${install-dir}

# Her Interactive's download: a Windows installer, or a Mac app whose
# Windows game is taken out
FROM prefix AS her-download
ARG install-dir
USE her-download
USE nancy-drew
her-download.INSTALL installer --into=${install-dir}
DO nancy-drew.patch --id=waters-edge-recorder-tea-ceremony --into=${install-dir}

# Her Interactive's Mac download: a Cider app, whose Windows game is taken
# out where Cider had it. Her's patches update older builds than it, so none
# apply.
FROM prefix AS her-mac
USE her-download
USE nancy-drew
her-download.INSTALL installer

# Steam's edition names no stage: the steam module's default stages build it.
