// markdownlint-cli2 settings; the rules themselves are in .markdownlint.jsonc.
{
  "ignores": [
    // Generated by `sc release`.
    "CHANGELOG.md",
    // Frozen records, not edited as the code moves on (see AGENTS.md).
    "docs/historical-plans/**",
    // Build output, packages and local notes, not ours to lint.
    "DerivedData/**",
    "**/.build/**",
    "build/**",
    ".local/**",
    "installers/**",
    "test-results/**"
  ]
}
