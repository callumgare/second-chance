# DO nancy-drew.patch --id=<patch> --into=<the game's folder>
#
# Applies one of Her Interactive's official patches (patches.json, by its
# id; docs/game-patches.md), as the step its kind takes says. The patch's
# archive is found by its sha256 in the download cache. Each step is named
# after the patch, so a skipped one is recorded by its id, and a failure asks
# whether to carry on without it, as the game still works.
FUNCTION patch
  INPUT id
  INPUT into
  VAR patch = ${self.data.patches[input.id]}
  VAR target = "${input.into}/${var.patch.destinationSubdirectory}"
  IF ${var.patch.action} = "copy-into-game-dir"
    # A data file, dropped into the game's folder.
    ADD --name=${input.id} --on-failure=ask --checksum=sha256:${var.patch.sha256} \
        --unpack=zip --member=${var.patch.payload} ${var.patch.url} ${var.target}
  ELSE IF ${var.patch.action} = "extract-into-game-dir"
    # A self-extracting zip, unpacked into the game's folder.
    ADD --name=${input.id} --on-failure=ask --checksum=sha256:${var.patch.sha256} \
        --unpack=zip --member=${var.patch.payload} --extract ${var.patch.url} ${var.target}
  ELSE IF ${var.patch.automation} = "none"
    # A patcher with a silent mode, run in the game's folder, where these
    # old patchers look for the game; it isn't an install, so nothing is
    # looked for afterwards.
    INSTALLER.RUN --name=${input.id} --on-failure=ask --patch --into=${input.into} \
        --mount=type=fetch,url=${var.patch.url},sha256=${var.patch.sha256},unpack=zip,member=${var.patch.payload},target=${input.into}/${var.patch.payload} \
        ${input.into}/${var.patch.payload}
  ELSE
    # A wizard with no silent mode, clicked through by its AutoIt script,
    # which exits 0 only once the patcher says the game was updated. Both
    # are module files: this module's, and the installer module's.
    # /ErrorStdOut: a script error is printed rather than shown in a box
    # nobody will close.
    RUN --name=${input.id} --on-failure=ask \
        --mount=type=fetch,url=${var.patch.url},sha256=${var.patch.sha256},unpack=zip,member=${var.patch.payload},target=${input.into}/${var.patch.payload} \
        --mount=type=bind,source=assets/${var.patch.automation}.au3,target=C:/patch.au3 \
        --mount=type=bind,source=module:installer:/autoit,target=C:/autoit \
        C:/autoit/AutoIt3.exe /ErrorStdOut C:/patch.au3 ${input.into}/${var.patch.payload}
  END
END
