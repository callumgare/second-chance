{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Wrappfile",
    "scopeName": "source.wrappfile",
    "comment": "The syntax is docs/wrappfile.md's; WrappfileGrammarTests checks the instructions here are InstructionSpec.core's.",
    "patterns": [
        { "include": "#comment" },
        { "include": "#from" },
        { "include": "#use" },
        { "include": "#declaration" },
        { "include": "#function" },
        { "include": "#do" },
        { "include": "#condition" },
        { "include": "#block" },
        { "include": "#instruction" },
        { "include": "#module-instruction" },
        { "include": "#words" }
    ],
    "repository": {
        "comment": {
            "match": "(?<!\\S)#.*$",
            "name": "comment.line.number-sign.wrappfile"
        },
        "from": {
            "match": "(?i)^\\s*(FROM)\\s+([^\\s@/]+)(?:(@)([^\\s/]+))?(?:(/)(\\S+))?(?:\\s+(AS)\\s+(\\S+))?",
            "captures": {
                "1": { "name": "keyword.other.instruction.wrappfile" },
                "2": { "name": "entity.name.type.stage.wrappfile" },
                "3": { "name": "punctuation.separator.version.wrappfile" },
                "4": { "name": "constant.numeric.version.wrappfile" },
                "5": { "name": "punctuation.separator.stage.wrappfile" },
                "6": { "name": "entity.name.type.stage.wrappfile" },
                "7": { "name": "keyword.other.as.wrappfile" },
                "8": { "name": "entity.name.type.stage.wrappfile" }
            }
        },
        "use": {
            "match": "(?i)^\\s*(USE)\\s+([^\\s@]+)(?:(@)(\\S+))?(?:\\s+(AS)\\s+(\\S+))?",
            "captures": {
                "1": { "name": "keyword.other.instruction.wrappfile" },
                "2": { "name": "entity.name.namespace.module.wrappfile" },
                "3": { "name": "punctuation.separator.version.wrappfile" },
                "4": { "name": "constant.numeric.version.wrappfile" },
                "5": { "name": "keyword.other.as.wrappfile" },
                "6": { "name": "entity.name.namespace.module.wrappfile" }
            }
        },
        "declaration": {
            "comment": "INPUT, CONST, VAR and SET: a name, then = and a value, spaced or not.",
            "match": "(?i)^\\s*(INPUT|CONST|VAR|SET)\\s+([^\\s=]+)\\s*(=)?",
            "captures": {
                "1": { "name": "keyword.other.instruction.wrappfile" },
                "2": { "name": "variable.other.readwrite.wrappfile" },
                "3": { "name": "keyword.operator.assignment.wrappfile" }
            }
        },
        "function": {
            "match": "(?i)^\\s*(FUNCTION)\\s+(\\S+)",
            "captures": {
                "1": { "name": "storage.type.function.wrappfile" },
                "2": { "name": "entity.name.function.wrappfile" }
            }
        },
        "do": {
            "match": "(?i)^\\s*(DO)\\s+(?:([^\\s.]+)(\\.))?([^\\s.]+)",
            "captures": {
                "1": { "name": "keyword.other.instruction.wrappfile" },
                "2": { "name": "entity.name.namespace.module.wrappfile" },
                "3": { "name": "punctuation.accessor.wrappfile" },
                "4": { "name": "entity.name.function.wrappfile" }
            }
        },
        "condition": {
            "begin": "(?i)^\\s*(IF|ELSE\\s+IF)(?=\\s|$)",
            "beginCaptures": {
                "1": { "name": "keyword.control.conditional.wrappfile" }
            },
            "end": "(?<!\\\\)$",
            "patterns": [
                { "include": "#comment" },
                {
                    "match": "!=|=",
                    "name": "keyword.operator.comparison.wrappfile"
                },
                { "include": "#words" }
            ]
        },
        "block": {
            "match": "(?i)^\\s*(ELSE|END|LAYER)(?=\\s|$)",
            "captures": {
                "1": { "name": "keyword.control.wrappfile" }
            }
        },
        "instruction": {
            "match": "(?i)^\\s*(RUN|COPY|ADD|EXPORT|MOVE|REMOVE|EDIT)(?=\\s|$)",
            "captures": {
                "1": { "name": "keyword.other.instruction.wrappfile" }
            }
        },
        "module-instruction": {
            "comment": "A module's instruction, WINE.MOUNT in any case, or MODULE.<NAME>.<INSTRUCTION> naming the module in full.",
            "match": "(?i)^\\s*(?:(MODULE)(\\.))?([a-z][a-z0-9-]*)(\\.)([a-z][a-z0-9-]*)(?=\\s|$)",
            "captures": {
                "1": { "name": "keyword.other.module.wrappfile" },
                "2": { "name": "punctuation.accessor.wrappfile" },
                "3": { "name": "entity.name.namespace.module.wrappfile" },
                "4": { "name": "punctuation.accessor.wrappfile" },
                "5": { "name": "keyword.other.instruction.wrappfile" }
            }
        },
        "words": {
            "patterns": [
                { "include": "#comment" },
                { "include": "#string" },
                { "include": "#substitution" },
                { "include": "#option" },
                { "include": "#path-type" },
                { "include": "#mount-field" },
                {
                    "match": "\\$\\$",
                    "name": "constant.character.escape.dollar.wrappfile"
                },
                {
                    "match": "\\\\$",
                    "name": "constant.character.escape.line-continuation.wrappfile"
                }
            ]
        },
        "option": {
            "comment": "--name, or a module's --<module>.<name>.",
            "match": "(?<!\\S)(--)(?:([a-z][a-z0-9-]*)(\\.))?([a-z][a-z0-9-]*)(=)?",
            "captures": {
                "1": { "name": "variable.parameter.option.wrappfile" },
                "2": { "name": "entity.name.namespace.module.wrappfile" },
                "3": { "name": "punctuation.accessor.wrappfile" },
                "4": { "name": "variable.parameter.option.wrappfile" },
                "5": { "name": "keyword.operator.assignment.wrappfile" }
            }
        },
        "string": {
            "begin": "\"",
            "beginCaptures": {
                "0": { "name": "punctuation.definition.string.begin.wrappfile" }
            },
            "end": "\"(?!\")",
            "endCaptures": {
                "0": { "name": "punctuation.definition.string.end.wrappfile" }
            },
            "name": "string.quoted.double.wrappfile",
            "patterns": [
                {
                    "match": "\"\"",
                    "name": "constant.character.escape.quote.wrappfile"
                },
                {
                    "match": "\\$\\$",
                    "name": "constant.character.escape.dollar.wrappfile"
                },
                { "include": "#substitution" },
                { "include": "#path-type" }
            ]
        },
        "substitution": {
            "comment": "${namespace.path[key].field}: a namespace (or a module's name), names, and a key worked out from a value in brackets.",
            "begin": "\\$\\{",
            "beginCaptures": {
                "0": { "name": "punctuation.definition.variable.begin.wrappfile" }
            },
            "end": "\\}",
            "endCaptures": {
                "0": { "name": "punctuation.definition.variable.end.wrappfile" }
            },
            "name": "variable.other.substitution.wrappfile",
            "patterns": [
                {
                    "match": "(?<=\\$\\{|\\[)(input|const|var|platform|module|self|program)(?=\\.)",
                    "name": "support.variable.namespace.wrappfile"
                },
                {
                    "begin": "\\[",
                    "beginCaptures": {
                        "0": { "name": "punctuation.section.brackets.begin.wrappfile" }
                    },
                    "end": "\\]",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.brackets.end.wrappfile" }
                    },
                    "patterns": [
                        {
                            "match": "^(input|const|var|platform|module|self)(?=\\.)",
                            "name": "support.variable.namespace.wrappfile"
                        }
                    ]
                },
                {
                    "match": "\\.",
                    "name": "punctuation.accessor.wrappfile"
                }
            ]
        },
        "path-type": {
            "comment": "A path in a module's type, in full form (wine:C:/…, steam://…), or a bundle's or module's file (bundle:…, module:…).",
            "match": "(?<=^|[\\s=,\"])(wine|dosbox|scummvm|steam|big-fish|bundle|module)(:)",
            "captures": {
                "1": { "name": "storage.type.path-type.wrappfile" },
                "2": { "name": "punctuation.separator.path-type.wrappfile" }
            }
        },
        "mount-field": {
            "comment": "A module's field in a --mount: wine.drive=.",
            "match": "(?<=,)([a-z][a-z0-9-]*)(\\.)([a-z][a-z0-9-]*)(=)",
            "captures": {
                "1": { "name": "entity.name.namespace.module.wrappfile" },
                "2": { "name": "punctuation.accessor.wrappfile" },
                "3": { "name": "variable.parameter.field.wrappfile" },
                "4": { "name": "keyword.operator.assignment.wrappfile" }
            }
        }
    }
}
